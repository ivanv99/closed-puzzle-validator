      "effect": {
        "op": "compose",
        "steps": [
          {
            "op": "compose",
            "if": "notMatched",
            "delayMs": 1500,
            "steps": [
              {
                "op": "setVisible",
                "value": false,
                "where": {
                  "op": "checkProperty",
                  "args": [
                    "$it",
                    "focused"
                  ]
                }
              },
              {
                "op": "setProperty",
                "property": "focused",
                "value": false
              }
            ]
          },
          {
            "op": "playSound",
            "sound": "WellDone.wav",
            "if": "matched"
          },
          {
            "op": "incrementResult",
            "by": 1,
            "if": "matched"
          },
          {
            "op": "setProperty",
            "property": "focused",
            "value": false,
            "if": "matched"
          }
        ]
      }
    }
