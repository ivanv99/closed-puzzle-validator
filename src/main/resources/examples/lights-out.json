      "actions": ["Press"]
    }
  },
  "A": [
    {
      "id": "Press",
      "kind": "click",
      "origin": "player"
    }
  ],
  "R": [
    {
      "id": "R-press",
      "action": "Press",
      "fire": [
        "E-toggleSelfAndNeighbours"
      ]
    }
  ],
  "E": [
    {
      "id": "E-toggleSelfAndNeighbours",
      "effect": {
        "op": "compose",
        "steps": [
          {
            "op": "setProperty",
            "target": "$target",
            "property": "focused",
            "value": "$not($target.focused)"
          },
          {
            "op": "setProperty",
            "target": "$neighbour(N)",
            "property": "focused",
            "value": "$not($neighbour(N).focused)"
          },
          {
            "op": "setProperty",
            "target": "$neighbour(S)",
            "property": "focused",
            "value": "$not($neighbour(S).focused)"
          },
          {
            "op": "setProperty",
            "target": "$neighbour(E)",
            "property": "focused",
            "value": "$not($neighbour(E).focused)"
          },
          {
            "op": "setProperty",
            "target": "$neighbour(W)",
            "property": "focused",
            "value": "$not($neighbour(W).focused)"
          }
        ]
      }
    }
  ],
  "F": [
    {
      "id": "allOff",
      "expression": {
        "op": "and",
        "args": [
          {
